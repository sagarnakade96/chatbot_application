# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
# Used by the plain-boto3 scripts (01_agent.py, 03_guardrails.py,
# learning_app_kb/01_connection_file.py). The langchain/ and langgraph/
# code instead reads an AWS shared-credentials profile (see AGENTS.md).

AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# Bedrock Knowledge Base id (learning_app_kb/)
KNOWLEDGE_BASE_ID=your-knowledge-base-id
